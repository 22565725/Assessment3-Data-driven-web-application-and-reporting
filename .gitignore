# Dependencies - must never be committed (assessment requirement)
node_modules/
**/node_modules/

# Next.js build output
.next/
**/.next/
out/
build/

# SQLite database files.
# The schema is tracked via api/prisma/migrations; the data is not.
*.db
*.db-journal
*.sqlite
api/sqlite/*
!api/sqlite/.gitkeep

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local env overrides (api/.env is committed deliberately - no secrets in it)
.env.local
.env.production

# Editor / OS
.DS_Store
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-error.log*

# AWS key material - must never reach GitHub
*.pem

# Submission artefacts that live beside the code now that the project root
# IS the repository root. Anchored with a leading slash so they only match
# the top level.
/*.mp4
/*.zip
/*.pem

# The Assessment 3 walkthrough at frontend/public/video/ IS tracked, so that
# a clone or a rebuild has everything the About page needs. A bind mount was
# tried instead to avoid the size, but an empty mounted directory shadows the
# file inside the image - so the simple thing wins.

# Course-provided documents (briefs, rubrics, feedback) kept alongside the
# code for convenience. They are not part of the submission itself.
/*.docx
/*.pdf

# Playwright output. The tests are tracked; their results are not - a report
# is a record of one run against one deployment, not part of the source.
playwright-report/
test-results/
blob-report/
.playwright/

# JMeter output. The plan and scripts are tracked; results are a record of
# one run against one deployment, and the HTML reports are large.
jmeter/results/

# Collected test reports are served by the client but not tracked: they are
# a record of one run against one deployment, and the HTML is bulky.
/reports/*
!/reports/.gitkeep

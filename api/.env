# SQLite connection string.
#
# Prisma resolves relative "file:" paths against the folder containing
# schema.prisma (api/prisma/), NOT the project root. So ../sqlite/dev.db
# puts the database in api/sqlite/ - its own directory, which the Docker
# volume mounts without shadowing schema.prisma or the migrations folder.
#
# Committed deliberately: this is a file path, not a credential.
# docker-compose.yml overrides it with an absolute path inside the container.
DATABASE_URL="file:../sqlite/dev.db"
